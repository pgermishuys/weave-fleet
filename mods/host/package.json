{
  "name": "@weave-fleet/mods-host",
  "version": "0.1.0",
  "private": true,
  "description": "Runs Fleet mods in one Bun process and talks to Fleet over stdio JSON-RPC (docs/mods/api.md)",
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build src/main.ts --target=bun --outfile dist/host.js",
    "compile": "bun build src/main.ts --compile --outfile dist/fleet-mods-host"
  },
  "dependencies": {
    "@sveltejs/acorn-typescript": "1.0.13",
    "acorn": "8.19.0",
    "eslint-scope": "9.1.2",
    "ses": "2.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
