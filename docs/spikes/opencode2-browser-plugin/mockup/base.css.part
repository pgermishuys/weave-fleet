/* Fleet's own tokens (client/src/assets/main.css), light first, dark redefined. */
:root {
  --main-bg: #F3F2EF; --rail-bg: #FFFFFF; --panel-bg: #FFFFFF; --card-bg: #FFFFFF;
  --sunken: #ECEAE6; --hover: rgba(26,25,24,.05); --active: rgba(26,25,24,.08);
  --border: rgba(26,25,24,.09); --border-strong: rgba(26,25,24,.16);
  --text: #1A1918; --muted: #6E6A65; --faint: #9a958f;
  --accent: #5B6EC7; --accent-dim: rgba(91,110,199,.12); --on-accent: #fff;
  --running: #16a34a; --idle: #d97706; --error: #dc2626;
  --ref-tint: rgba(91,110,199,.14);
  --shadow: 0 1px 2px rgba(26,25,24,.05), 0 16px 40px -20px rgba(26,25,24,.28);
  --page-bg: #EAE8E4; --page-ink: #1A1918; --page-muted: #6E6A65; --page-card: #F7F6F3;
  --sans: "Inter", system-ui, -apple-system, "Segoe UI", sans-serif;
  --mono: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  color-scheme: light;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --main-bg: #0d0d10; --rail-bg: #0d0d10; --panel-bg: #141418; --card-bg: #1b1b20;
    --sunken: #111115; --hover: rgba(255,255,255,.04); --active: rgba(255,255,255,.07);
    --border: rgba(255,255,255,.075); --border-strong: rgba(255,255,255,.14);
    --text: #e8e8ec; --muted: #8e8e9a; --faint: #5d5d68;
    --accent: #6366f1; --accent-dim: rgba(99,102,241,.16); --on-accent: #fff;
    --running: #22c55e; --idle: #f59e0b; --error: #ef4444;
    --ref-tint: rgba(99,102,241,.22);
    --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 20px 50px -24px rgba(0,0,0,.8);
    --page-bg: #08080a; --page-ink: #e8e8ec; --page-muted: #8e8e9a; --page-card: #111114;
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --main-bg: #0d0d10; --rail-bg: #0d0d10; --panel-bg: #141418; --card-bg: #1b1b20;
  --sunken: #111115; --hover: rgba(255,255,255,.04); --active: rgba(255,255,255,.07);
  --border: rgba(255,255,255,.075); --border-strong: rgba(255,255,255,.14);
  --text: #e8e8ec; --muted: #8e8e9a; --faint: #5d5d68;
  --accent: #6366f1; --accent-dim: rgba(99,102,241,.16); --on-accent: #fff;
  --running: #22c55e; --idle: #f59e0b; --error: #ef4444;
  --ref-tint: rgba(99,102,241,.22);
  --shadow: 0 1px 0 rgba(255,255,255,.03) inset, 0 20px 50px -24px rgba(0,0,0,.8);
  --page-bg: #08080a; --page-ink: #e8e8ec; --page-muted: #8e8e9a; --page-card: #111114;
  color-scheme: dark;
}

* { box-sizing: border-box; }
body { background: var(--page-bg); color: var(--page-ink); font: 14px/1.5 var(--sans); margin: 0; -webkit-font-smoothing: antialiased; }
.wrap { max-width: 1320px; margin: 0 auto; padding-inline: 20px; padding-block: 28px 64px; }
a { color: inherit; }
button { font: inherit; color: inherit; }
code, .mono { font-family: var(--mono); font-size: .9em; }
svg.i { width: 1em; height: 1em; flex-shrink: 0; stroke: currentColor; fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vertical-align: -.125em; }
h1, h2, h3, h4 { text-wrap: balance; }

/* page chrome */
.eyebrow { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--page-muted); font-weight: 600; }
h1 { font-size: 30px; line-height: 1.15; letter-spacing: -.02em; margin: 4px 0 8px; }
.lede { color: var(--page-muted); max-width: 74ch; margin: 0; font-size: 15px; }
.tabs { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 20; background: var(--page-bg); display: flex; gap: 2px; overflow-x: auto; padding-block: 10px; border-bottom: 1px solid var(--border); margin: 18px 0 24px; scrollbar-width: none; }
.tab { border: 0; background: none; padding: 7px 12px; border-radius: 8px; color: var(--page-muted); font-size: 13px; font-weight: 500; cursor: pointer; white-space: nowrap; display: inline-flex; gap: 7px; align-items: center; }
.tab:hover { color: var(--page-ink); background: var(--hover); }
.tab[aria-selected="true"] { color: var(--page-ink); background: var(--active); }
.tab .n { font-family: var(--mono); font-size: 11px; color: var(--faint); }
button:focus-visible, [tabindex]:focus-visible, input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.view[hidden] { display: none !important; }
.view-head { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 20px; align-items: end; margin-bottom: 16px; }
.view-head h2 { font-size: 21px; letter-spacing: -.01em; margin: 0 0 4px; }
.view-head p { margin: 0; color: var(--page-muted); max-width: 76ch; }
@media (max-width: 800px) { .view-head { grid-template-columns: 1fr; } }
.seg { display: inline-flex; padding: 3px; border-radius: 9px; background: var(--active); gap: 2px; flex-wrap: wrap; }
.seg button { border: 0; background: none; padding: 5px 12px; border-radius: 7px; font-size: 12.5px; font-weight: 500; color: var(--page-muted); cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--card-bg); color: var(--page-ink); box-shadow: 0 1px 2px rgba(0,0,0,.2); }
.scroller { overflow-x: auto; border-radius: 14px; padding-bottom: 4px; }
.notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(290px, 1fr)); gap: 14px; font-size: 13px; margin-top: 16px; align-items: start; }
.card { background: var(--page-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; }
.card h3 { font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--page-muted); margin: 0 0 8px; font-weight: 600; }
.card ul { margin: 0; padding-left: 18px; display: grid; gap: 6px; }
.card li::marker { color: var(--faint); }
.card p { margin: 0 0 6px; }
.src { display: inline-block; font-family: var(--mono); font-size: 11px; color: var(--page-muted); background: var(--active); border-radius: 5px; padding: 1px 6px; }

/* provider marks */
.pv { width: 18px; height: 18px; border-radius: 5px; display: inline-grid; place-items: center; font: 700 10px/1 var(--sans); color: #fff; flex-shrink: 0; letter-spacing: 0; }
.pv.lg { width: 30px; height: 30px; border-radius: 8px; font-size: 14px; }
.pv.sm { width: 14px; height: 14px; border-radius: 4px; font-size: 8.5px; }
.pv.github { background: #24292f; } .pv.linear { background: #5E6AD2; } .pv.notion { background: #2f2f2f; }
.pv.drive { background: #1a8f55; } .pv.hubspot { background: #e5603e; } .pv.slack { background: #611f69; }
.pv.sentry { background: #4a3d74; } .pv.atlassian { background: #0c66e4; } .pv.mcp { background: var(--muted); }
:root[data-theme="dark"] .pv.github, :root[data-theme="dark"] .pv.notion { box-shadow: inset 0 0 0 1px rgba(255,255,255,.18); }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) .pv.github, :root:not([data-theme="light"]) .pv.notion { box-shadow: inset 0 0 0 1px rgba(255,255,255,.18); } }

/* Fleet app frame */
.app { min-width: 1160px; height: 680px; display: grid; grid-template-columns: 52px 268px minmax(0, 1fr); background: var(--rail-bg); border: 1px solid var(--border); border-radius: 14px; overflow: hidden; box-shadow: var(--shadow); color: var(--text); font-size: 13px; position: relative; }
.app.no-list { grid-template-columns: 52px minmax(0, 1fr); }
.app.sess { grid-template-columns: 52px 240px minmax(0, 1fr); }
.rail { display: flex; flex-direction: column; align-items: center; gap: 4px; padding-block: 12px; background: var(--rail-bg); }
.rail .logo { width: 24px; height: 14px; margin-bottom: 12px; background: linear-gradient(90deg, #6366f1, #ec4899 60%, #3b82f6); clip-path: polygon(0 0, 18% 0, 32% 70%, 46% 0, 54% 0, 68% 70%, 82% 0, 100% 0, 76% 100%, 60% 100%, 50% 42%, 40% 100%, 24% 100%); }
.rail .ri { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 9px; color: var(--muted); font-size: 17px; position: relative; }
.rail .ri.on { background: var(--active); color: var(--text); }
.rail .ri.new::after { content: ""; position: absolute; top: 6px; right: 6px; width: 6px; height: 6px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 2px var(--rail-bg); }
.rail .sp { flex: 1; }
.list { background: var(--rail-bg); padding: 12px 10px; display: flex; flex-direction: column; gap: 2px; overflow: hidden; }
.main { background: var(--panel-bg); margin: 8px 8px 8px 0; border-radius: 12px; border: 1px solid var(--border); overflow: hidden; display: flex; flex-direction: column; min-width: 0; position: relative; }
.app.no-list .main { margin-left: 0; }
.lhead { display: flex; align-items: center; gap: 8px; padding: 2px 6px 10px; }
.lhead b { font-size: 14px; font-weight: 600; flex: 1; }
.search { height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--sunken); display: flex; align-items: center; gap: 8px; padding: 0 10px; color: var(--faint); font-size: 12.5px; margin-bottom: 8px; }
.search .sq { color: var(--text); flex: 1; }
.search .kbd { margin-left: auto; }
.grp { display: flex; align-items: center; gap: 6px; color: var(--faint); font-size: 11px; letter-spacing: .06em; text-transform: uppercase; font-weight: 600; padding: 12px 8px 4px; }
.row { display: flex; align-items: center; gap: 9px; min-height: 34px; padding: 0 8px; border-radius: 8px; color: var(--text); cursor: pointer; min-width: 0; border: 0; background: none; width: 100%; text-align: left; font-size: 13px; }
.row:hover { background: var(--hover); }
.row.sel { background: var(--active); }
.row .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.row .t small { display: block; color: var(--muted); font-size: 11px; line-height: 1.2; }
.row.dim .t { color: var(--muted); }
.row .st { font-size: 11px; color: var(--muted); white-space: nowrap; }
.ok-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--running); flex-shrink: 0; }
.warn-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--idle); flex-shrink: 0; }
.kbd { font-family: var(--mono); font-size: 10.5px; padding: 1px 5px; border-radius: 4px; background: var(--active); color: var(--muted); }
.btn { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--border); background: var(--card-bg); color: var(--text); font-size: 12.5px; font-weight: 500; cursor: pointer; white-space: nowrap; }
.btn:hover { border-color: var(--border-strong); }
.btn.primary { background: var(--accent); color: var(--on-accent); border-color: transparent; }
.btn.primary:hover { filter: brightness(1.07); }
.btn.ghost { background: none; border-color: transparent; color: var(--muted); }
.btn.ghost:hover { color: var(--text); background: var(--hover); }
.btn.sm { height: 24px; padding: 0 8px; font-size: 12px; }
.btn[disabled] { opacity: .55; cursor: default; }
.ro { display: inline-flex; align-items: center; gap: 4px; height: 20px; padding: 0 7px; border-radius: 999px; font-size: 11px; font-weight: 500; color: var(--muted); background: var(--active); white-space: nowrap; }
.spin { animation: spin 1s linear infinite; display: inline-block; }
@keyframes spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .spin, .dots i, .caret { animation: none !important; } }
.switch { position: relative; width: 28px; height: 16px; border-radius: 999px; border: 0; background: var(--border-strong); padding: 0; cursor: pointer; flex-shrink: 0; }
.switch::after { content: ""; position: absolute; top: 2px; left: 2px; width: 12px; height: 12px; border-radius: 50%; background: #fff; transition: transform 150ms ease-out; }
.switch[aria-checked="true"] { background: var(--accent); }
.switch[aria-checked="true"]::after { transform: translateX(12px); }

/* sources browse */
.browse { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); height: 100%; min-height: 0; }
.results { border-right: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; }
.rhead { padding: 14px 16px 10px; display: grid; gap: 10px; border-bottom: 1px solid var(--border); }
.rhead h3 { margin: 0; font-size: 16px; font-weight: 600; letter-spacing: -.01em; }
.fchips { display: flex; gap: 6px; flex-wrap: wrap; }
.fchip { height: 26px; padding: 0 9px; border-radius: 7px; border: 1px solid var(--border); display: inline-flex; align-items: center; gap: 6px; color: var(--muted); font-size: 12px; background: none; cursor: pointer; }
.fchip[aria-pressed="true"] { background: var(--accent-dim); color: var(--text); border-color: transparent; }
.fchip .c { font-family: var(--mono); font-size: 10.5px; color: var(--faint); }
.rlist { padding: 6px; overflow: auto; display: grid; gap: 1px; align-content: start; }
.res { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 3px 10px; padding: 9px 10px; border-radius: 9px; cursor: pointer; border: 0; background: none; text-align: left; width: 100%; }
.res:hover { background: var(--hover); }
.res.sel { background: var(--active); }
.res .pv { margin-top: 1px; }
.res .tt { font-weight: 500; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.res .sn { grid-column: 2; color: var(--muted); font-size: 12px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.res .mt { grid-column: 2; color: var(--faint); font-size: 11px; font-family: var(--mono); display: flex; gap: 8px; }
.res mark { background: color-mix(in srgb, var(--accent) 22%, transparent); color: inherit; border-radius: 2px; padding: 0 1px; }
.preview { display: flex; flex-direction: column; min-height: 0; background: var(--panel-bg); }
.phead { padding: 14px 18px 12px; border-bottom: 1px solid var(--border); display: grid; gap: 8px; }
.phead .crumb { display: flex; align-items: center; gap: 7px; color: var(--muted); font-size: 12px; }
.phead h3 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -.01em; line-height: 1.3; }
.phead .acts { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.phead .acts .grow { flex: 1; }
.doc { padding: 16px 22px 24px; overflow: auto; line-height: 1.62; font-size: 13.5px; }
.doc h4 { font-size: 13.5px; margin: 14px 0 4px; color: var(--accent); font-weight: 600; }
.doc p { margin: 0 0 10px; max-width: 64ch; }
.doc ul { margin: 0 0 10px; padding-left: 20px; }
.doc code { background: var(--sunken); padding: 0 4px; border-radius: 4px; font-size: 12px; }
.doc .props { display: grid; grid-template-columns: 110px 1fr; gap: 4px 12px; font-size: 12.5px; margin-bottom: 14px; padding: 10px 12px; background: var(--sunken); border-radius: 9px; }
.doc .props span:nth-child(odd) { color: var(--muted); }
.attach-menu { position: absolute; z-index: 6; right: 18px; top: 92px; width: 300px; background: var(--card-bg); border: 1px solid var(--border-strong); border-radius: 11px; box-shadow: var(--shadow); padding: 5px; }
.attach-menu .mh { font-size: 11px; color: var(--faint); padding: 7px 8px 4px; letter-spacing: .05em; text-transform: uppercase; font-weight: 600; }
.mi { display: flex; align-items: center; gap: 8px; padding: 7px 8px; border-radius: 7px; cursor: pointer; font-size: 12.5px; border: 0; background: none; width: 100%; text-align: left; }
.mi:hover { background: var(--hover); }
.mi .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mi small { color: var(--muted); }
.dots { display: inline-grid; grid-template-columns: repeat(2, 3px); gap: 2px; }
.dots i { width: 3px; height: 3px; border-radius: 1px; background: var(--accent); animation: tick 1.2s infinite; }
.dots i:nth-child(2) { animation-delay: .3s; } .dots i:nth-child(3) { animation-delay: .9s; } .dots i:nth-child(4) { animation-delay: .6s; }
@keyframes tick { 0%, 100% { opacity: .25 } 50% { opacity: 1 } }
.toast { position: absolute; left: 50%; bottom: 18px; transform: translateX(-50%); background: var(--text); color: var(--panel-bg); padding: 8px 14px; border-radius: 9px; font-size: 12.5px; box-shadow: var(--shadow); z-index: 8; display: flex; gap: 10px; align-items: center; white-space: nowrap; }
.toast b { font-weight: 600; }

/* connect */
.cpage { flex: 1; overflow: auto; padding: 28px 34px; display: grid; gap: 22px; align-content: start; }
.chead { display: flex; gap: 14px; align-items: center; }
.chead h3 { margin: 0; font-size: 20px; font-weight: 600; letter-spacing: -.015em; }
.chead p { margin: 2px 0 0; color: var(--muted); }
.cgrid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 20px; align-items: start; }
.box { border: 1px solid var(--border); border-radius: 12px; background: var(--card-bg); padding: 16px 18px; display: grid; gap: 12px; }
.box h4 { margin: 0; font-size: 13px; font-weight: 600; }
.box .sub { color: var(--muted); font-size: 12.5px; margin: 0; }
.cap { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto; gap: 2px 10px; align-items: start; font-size: 12.5px; }
.cap .ic { color: var(--running); margin-top: 2px; }
.cap .ic.no { color: var(--faint); }
.cap small { grid-column: 2; color: var(--muted); }
.steps { display: grid; gap: 0; }
.step { display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; padding: 8px 0; font-size: 12.5px; color: var(--muted); }
.step .b { width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--border-strong); display: grid; place-items: center; font-size: 10.5px; font-family: var(--mono); }
.step.done { color: var(--text); }
.step.done .b { background: var(--running); border-color: transparent; color: #fff; }
.step.now { color: var(--text); }
.step.now .b { border-color: var(--accent); color: var(--accent); }
.field { display: grid; gap: 5px; }
.field label { font-size: 12px; font-weight: 500; color: var(--muted); }
.input { height: 30px; border: 1px solid var(--border-strong); background: var(--sunken); color: var(--text); border-radius: 7px; padding: 0 9px; font: 12.5px var(--sans); display: flex; align-items: center; gap: 8px; min-width: 0; }
.input.mono { font: 12px var(--mono); }
.input .grow { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.callout { border-radius: 10px; padding: 10px 12px; font-size: 12.5px; background: color-mix(in srgb, var(--idle) 10%, transparent); border: 1px solid color-mix(in srgb, var(--idle) 28%, transparent); }
.callout.info { background: var(--accent-dim); border-color: color-mix(in srgb, var(--accent) 25%, transparent); }
.gfile { display: flex; align-items: center; gap: 9px; padding: 6px 8px; border-radius: 8px; font-size: 12.5px; }
.gfile:hover { background: var(--hover); }
.gfile .t { flex: 1; }
.gfile .w { color: var(--faint); font-size: 11px; }

/* session */
.shead { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-bottom: 1px solid var(--border); min-height: 54px; position: relative; }
.shead .ttl { min-width: 0; flex: 1; }
.shead .ttl b { display: block; font-weight: 600; font-size: 13.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.shead .ttl small { color: var(--muted); font-size: 11.5px; display: flex; gap: 6px; align-items: center; white-space: nowrap; }
.hchip { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 9px; border-radius: 8px; border: 1px solid var(--border); background: var(--card-bg); font-size: 12px; cursor: pointer; white-space: nowrap; }
.hchip:hover, .hchip[aria-expanded="true"] { border-color: var(--border-strong); }
.hchip .stack { display: inline-flex; }
.hchip .stack .pv { margin-left: -4px; box-shadow: 0 0 0 1.5px var(--card-bg); }
.hchip .stack .pv:first-child { margin-left: 0; }
.convo { flex: 1; padding: 20px 24px 10px; display: flex; flex-direction: column; gap: 14px; overflow: auto; min-height: 0; }
.bubble { align-self: flex-end; background: var(--card-bg); border: 1px solid var(--border); padding: 9px 13px; border-radius: 12px; max-width: 76%; display: grid; gap: 7px; }
.reply { max-width: 92%; color: var(--text); line-height: 1.62; display: grid; gap: 8px; }
.reply p { margin: 0; }
.who { font-size: 11.5px; color: var(--muted); display: flex; gap: 6px; align-items: center; }
.tcard { border: 1px solid var(--border); border-radius: 10px; background: var(--card-bg); overflow: hidden; max-width: 640px; }
.tcard > button { display: flex; align-items: center; gap: 8px; width: 100%; padding: 7px 10px; border: 0; background: none; cursor: pointer; text-align: left; font-size: 12.5px; color: var(--muted); }
.tcard > button b { color: var(--text); font-weight: 500; white-space: nowrap; }
.tcard > button .tx { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; display: block; }
.tcard > button .r { margin-left: auto; white-space: nowrap; flex-shrink: 0; font-size: 11px; font-family: var(--mono); color: var(--faint); display: inline-flex; gap: 8px; align-items: center; }
.tcard .body { border-top: 1px solid var(--border); padding: 6px; display: grid; gap: 1px; }
.tcard .body[hidden] { display: none; }
.tline { display: flex; align-items: center; gap: 8px; padding: 5px 6px; border-radius: 6px; font-size: 12.5px; }
.tline:hover { background: var(--hover); }
.tline .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tline .ref { font-family: var(--mono); font-size: 11px; color: var(--faint); }
.cite { display: inline-flex; align-items: center; gap: 4px; height: 20px; padding: 0 6px; border-radius: 5px; background: var(--ref-tint); font-size: 12px; vertical-align: 1px; cursor: pointer; border: 0; color: var(--text); }
.cite:hover { filter: brightness(1.1); }
.composer { margin: 0 16px 14px; border: 1px solid var(--border-strong); border-radius: 13px; background: var(--card-bg); padding: 10px 12px; display: grid; gap: 10px; position: relative; }
.pills { display: flex; flex-wrap: wrap; gap: 6px; }
.pills:empty { display: none; }
.spill { display: inline-flex; align-items: center; gap: 6px; height: 24px; padding: 0 4px 0 6px; border-radius: 6px; background: var(--ref-tint); font-size: 12.5px; max-width: 100%; }
.spill .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 280px; }
.spill .tk { font-family: var(--mono); font-size: 10.5px; color: var(--muted); }
.spill button { border: 0; background: none; color: var(--muted); cursor: pointer; padding: 0 4px; border-radius: 4px; font-size: 14px; line-height: 1; }
.spill button:hover { color: var(--text); background: var(--hover); }
.ctext { font-size: 14px; min-height: 22px; line-height: 1.55; outline: none; }
.ctext .ph { color: var(--faint); }
.caret { display: inline-block; width: 1.5px; height: 16px; background: var(--accent); vertical-align: -3px; animation: blink 1s steps(1) infinite; }
@keyframes blink { 50% { opacity: 0 } }
.cbar { display: flex; gap: 10px; align-items: center; font-size: 12px; color: var(--muted); }
.cbar .tag { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 8px; border-radius: 7px; background: var(--hover); }
.send { margin-left: auto; width: 28px; height: 28px; border-radius: 50%; background: var(--accent); display: grid; place-items: center; color: #fff; border: 0; cursor: pointer; }
.picker { position: absolute; left: 10px; bottom: calc(100% + 6px); width: 520px; background: var(--card-bg); border: 1px solid var(--border-strong); border-radius: 12px; box-shadow: var(--shadow); z-index: 6; overflow: hidden; }
.picker .ptabs { display: flex; gap: 2px; padding: 6px 8px; border-bottom: 1px solid var(--border); flex-wrap: wrap; }
.picker .ptabs button { border: 0; background: none; height: 26px; padding: 0 9px; border-radius: 7px; font-size: 12px; color: var(--muted); display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
.picker .ptabs button[aria-pressed="true"] { background: var(--active); color: var(--text); }
.picker .pq { display: flex; gap: 8px; align-items: center; padding: 8px 12px 4px; font-size: 12px; color: var(--muted); }
.picker .pq .sq { font-family: var(--mono); color: var(--text); }
.pick { display: grid; grid-template-columns: 18px minmax(0, 1fr) auto; gap: 1px 9px; align-items: center; padding: 7px 12px; cursor: pointer; border: 0; background: none; width: 100%; text-align: left; }
.pick:hover, .pick.on { background: var(--hover); }
.pick .tt { font-size: 12.5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pick .sb { grid-column: 2; font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.pick .x { grid-row: 1 / span 2; grid-column: 3; font-size: 11px; color: var(--faint); font-family: var(--mono); }
.picker .pf { display: flex; gap: 14px; padding: 7px 12px; border-top: 1px solid var(--border); font-size: 11px; color: var(--faint); }
.raw { font-size: 12px; }
.raw summary { cursor: pointer; color: var(--muted); }
.raw pre { margin: 6px 0 0; white-space: pre-wrap; font: 11.5px/1.5 var(--mono); padding: 8px 10px; background: var(--sunken); border: 1px solid var(--border); border-radius: 8px; color: var(--text); max-height: 220px; overflow: auto; }
.split2 { display: grid; grid-template-columns: minmax(0, 1fr) 400px; flex: 1; min-height: 0; }
.cpanel { border-left: 1px solid var(--border); display: flex; flex-direction: column; min-height: 0; background: var(--panel-bg); }
.ctabs { display: flex; gap: 2px; padding: 6px 8px 0; border-bottom: 1px solid var(--border); }
.ctabs span { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; font-size: 12px; color: var(--muted); border-bottom: 2px solid transparent; margin-bottom: -1px; }
.ctabs span.on { color: var(--text); border-bottom-color: var(--accent); }
.readby { display: flex; align-items: center; gap: 8px; padding: 8px 14px; font-size: 11.5px; color: var(--muted); background: var(--sunken); border-bottom: 1px solid var(--border); }
.pop { position: absolute; top: 48px; right: 12px; width: 360px; background: var(--card-bg); border: 1px solid var(--border-strong); border-radius: 12px; box-shadow: var(--shadow); z-index: 7; overflow: hidden; }
.pop header { padding: 11px 14px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 8px; }
.pop header b { flex: 1; font-size: 13px; }
.pop .sec { padding: 8px 10px; border-bottom: 1px solid var(--border); display: grid; gap: 2px; }
.pop .sec:last-child { border-bottom: 0; }
.pop .sh { font-size: 11px; color: var(--faint); text-transform: uppercase; letter-spacing: .05em; font-weight: 600; padding: 4px 4px; }
.prow { display: flex; align-items: center; gap: 8px; padding: 5px 4px; font-size: 12.5px; }
.prow .t { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.prow small { color: var(--faint); font-family: var(--mono); font-size: 10.5px; }
.hnote { font-size: 11.5px; color: var(--muted); padding: 4px 4px 2px; }

/* how + evidence */
.flow { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
@media (max-width: 860px) { .flow { grid-template-columns: 1fr; } }
.fstep { background: var(--page-card); border: 1px solid var(--border); border-radius: 12px; padding: 14px 16px; display: grid; gap: 6px; align-content: start; }
.fstep .k { font: 600 11px var(--mono); color: var(--accent); }
.fstep h3 { margin: 0; font-size: 15px; }
.fstep p { margin: 0; color: var(--page-muted); font-size: 13px; }
.sectitle { font-size: 17px; margin: 30px 0 10px; font-weight: 600; letter-spacing: -.01em; }
.sectitle + p.lede { margin-bottom: 12px; font-size: 13.5px; }
.why { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 12px; }
.why .card h4 { margin: 0 0 4px; font-size: 14px; }
.why .card p { margin: 0; color: var(--page-muted); font-size: 13px; }
.tablewrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; background: var(--page-card); }
table.t { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 12.5px; }
table.t th, table.t td { text-align: left; padding: 9px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
table.t thead th { font-size: 11px; letter-spacing: .06em; text-transform: uppercase; color: var(--page-muted); font-weight: 600; }
table.t tr:last-child td { border-bottom: 0; }
table.t td.n { font-family: var(--mono); font-variant-numeric: tabular-nums; }
.lvl { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 1px 6px; border-radius: 4px; white-space: nowrap; }
.lvl.go { background: color-mix(in srgb, var(--running) 16%, transparent); color: var(--running); }
.lvl.setup { background: color-mix(in srgb, var(--idle) 16%, transparent); color: var(--idle); }
.lvl.have { background: var(--accent-dim); color: var(--accent); }
.lvl.no { background: var(--active); color: var(--page-muted); }
.chart { display: grid; gap: 10px; padding: 16px 18px; }
.bar-row { display: grid; grid-template-columns: 210px minmax(0, 1fr); gap: 12px; align-items: center; font-size: 12.5px; }
.bar-row .lab { color: var(--page-ink); }
.bar-row .lab small { display: block; color: var(--page-muted); font-size: 11px; }
.bar-track { position: relative; height: 18px; }
.bar { position: absolute; left: 0; top: 2px; height: 14px; border-radius: 0 4px 4px 0; background: var(--muted); min-width: 3px; }
.bar.fleet { background: var(--accent); }
.bar-val { position: absolute; top: 0; font: 500 11.5px/18px var(--mono); color: var(--page-ink); white-space: nowrap; padding-left: 8px; font-variant-numeric: tabular-nums; }
.bar-row:hover .bar { filter: brightness(1.15); }
@media (max-width: 600px) { .bar-row { grid-template-columns: 1fr; gap: 4px; } }
.term { background: #0f0f13; color: #d7d7de; border-radius: 12px; padding: 14px 16px; font: 12px/1.6 var(--mono); overflow-x: auto; white-space: pre; border: 1px solid rgba(255,255,255,.08); }
.term .c { color: #8a8a99; } .term .g { color: #6ee7a0; } .term .y { color: #f5c36b; } .term .b { color: #a5b4fc; }
.two { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 14px; }
@media (max-width: 900px) { .two { grid-template-columns: 1fr; } }
.diagram { background: var(--page-card); border: 1px solid var(--border); border-radius: 14px; padding: 18px; overflow-x: auto; }
.dg { min-width: 900px; display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 0; align-items: stretch; }
.dcol { display: grid; gap: 8px; align-content: center; }
.dcol h4 { margin: 0 0 2px; font-size: 11px; letter-spacing: .07em; text-transform: uppercase; color: var(--page-muted); }
.dnode { background: var(--panel-bg); border: 1px solid var(--border-strong); border-radius: 10px; padding: 8px 11px; font-size: 12.5px; display: flex; gap: 9px; align-items: center; color: var(--text); }
.dnode small { display: block; color: var(--muted); font-size: 11px; }
.dfleet { background: var(--accent-dim); border: 1.5px solid color-mix(in srgb, var(--accent) 45%, transparent); border-radius: 14px; padding: 14px; display: grid; gap: 8px; margin-inline: 34px; position: relative; }
.dfleet::before, .dfleet::after { content: ""; position: absolute; top: 50%; width: 34px; border-top: 1.5px dashed var(--border-strong); }
.dfleet::before { left: -35px; } .dfleet::after { right: -35px; }
.dfleet h4 { margin: 0; font-size: 14px; color: var(--page-ink); text-transform: none; letter-spacing: 0; }
.dfleet .dnode { background: var(--panel-bg); }
.plan { display: grid; border: 1px solid var(--border); border-radius: 14px; overflow: hidden; background: var(--page-card); counter-reset: s; }
.plan .st { display: grid; grid-template-columns: 34px minmax(0, 1fr) auto; gap: 12px; padding: 13px 16px; border-bottom: 1px solid var(--border); align-items: start; }
.plan .st:last-child { border-bottom: 0; }
.plan .st::before { counter-increment: s; content: counter(s); font-family: var(--mono); font-size: 12px; color: var(--page-muted); border: 1px solid var(--border); border-radius: 7px; width: 26px; height: 26px; display: grid; place-items: center; }
.plan b { font-weight: 600; }
.plan p { margin: 3px 0 0; color: var(--page-muted); font-size: 13px; max-width: 90ch; }
.plan .sz { font-family: var(--mono); font-size: 11px; color: var(--page-muted); white-space: nowrap; padding-top: 3px; }
.qs { display: grid; gap: 10px; }
.q { background: var(--page-card); border: 1px solid var(--border); border-radius: 12px; padding: 12px 16px; }
.q b { display: block; margin-bottom: 3px; }
.q span { color: var(--page-muted); font-size: 13px; }
.q .rec { display: block; margin-top: 4px; font-size: 12.5px; color: var(--page-ink); }
.foot { margin-top: 36px; color: var(--page-muted); font-size: 12px; }
