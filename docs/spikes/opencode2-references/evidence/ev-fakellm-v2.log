s/github.com/octocat/Hello-World</path>\n    <description>Upstream sample repository</description>\n  </reference>\n  <reference>\n    <name>specs</name>\n    <path>/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs</path>\n    <description>Product specs for this app</description>\n  </reference>\n</available_references>\nWhen you create a worktree outside the current working directory and intend to use it as your primary working directory, consider using `execute` to call `tools.opencode.session_move` and make the worktree the session's working directory."}, {"role": "user", "content": "ask level with reference grant\nCALL read {\"path\": \"/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs/login.md\"}\nCALL grep {\"pattern\": \"login\", \"path\": \"/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs\"}\nCALL write {\"path\": \"/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs/evil.md\", \"content\": \"x\"}\nCALL read {\"path\": \"/home/pgermishuys/.cache/fleet-oc2-references/run/work/secret/readme.txt\"}\n"}, {"role": "assistant", "content": null, "tool_calls": [{"id": "call_1790885776033", "type": "function", "function": {"name": "read", "arguments": "{\"path\":\"/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs/login.md\"}"}}]}, {"role": "tool", "tool_call_id": "call_1790885776033", "content": "Read file /home/pgermishuys/.cache/fleet-oc2-references/run/work/specs/login.md, lines 1-1\n1: # Specs\\nThe login flow must time out after 15 minutes."}, {"role": "assistant", "content": null, "tool_calls": [{"id": "call_1790885776124", "type": "function", "function": {"name": "grep", "arguments": "{\"pattern\":\"login\",\"path\":\"/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs\"}"}}]}, {"role": "tool", "tool_call_id": "call_1790885776124", "content": "Found 1 matches\n/home/pgermishuys/.cache/fleet-oc2-references/run/work/specs/login.md:\n  Line 1: # Specs\\nThe login flow must time out after 15 minutes.\n