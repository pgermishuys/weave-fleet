<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <IsTrimmable>true</IsTrimmable>
    <!-- AOT/trimming only for Release (publish) builds; Debug uses JIT so Dapper reflection works -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <!-- Dapper 2.x does not have full AOT annotations; suppress aggregate trim/AOT warnings -->
    <NoWarn>$(NoWarn);IL2104;IL3053;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WeaveFleet.Application\WeaveFleet.Application.csproj" />
    <ProjectReference Include="..\WeaveFleet.Infrastructure\WeaveFleet.Infrastructure.csproj" />
    <ProjectReference Include="..\WeaveFleet.TestHarness\WeaveFleet.TestHarness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Observability -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The script the preview gateway adds to previewed pages; the client's mock mode serves the same file. -->
    <None Remove="Browser\preview-bridge.js" />
    <Content Remove="Browser\preview-bridge.js" />
    <EmbeddedResource Include="Browser\preview-bridge.js" LogicalName="browser/preview-bridge.js" />
  </ItemGroup>

  <ItemGroup>
    <!-- The page a node shows a browser at "/": it serves no web app, so the page and Fleet's logo travel inside. -->
    <None Remove="Node\node-page.html" />
    <Content Remove="Node\node-page.html" />
    <EmbeddedResource Include="Node\node-page.html" LogicalName="node/node-page.html" />
    <EmbeddedResource Include="..\..\client\src\assets\weave_logo.png" LogicalName="node/weave-logo.png" Link="Node\weave-logo.png" />
  </ItemGroup>

  <!-- Copy frontend SPA build output to wwwroot/ before building the backend.
       The Condition means: skip if client/dist/index.html doesn't exist yet
       (allows backend-only development without a frontend build). -->
  <Target Name="CopyFrontendDist" BeforeTargets="Build;ComputeFilesToPublish" Condition="Exists('$(MSBuildThisFileDirectory)..\..\client\dist\index.html')">
    <ItemGroup>
      <FrontendFiles Include="$(MSBuildThisFileDirectory)..\..\client\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Build the mod host (mods/host, Bun + TypeScript) into mods/host/dist/host.js, and ship it as mods-host/host.js in the
       build and publish output. Skipped when the file is already newer than its sources. Debug builds and test runs don't
       need Bun: with no bun on PATH (or at $(BunPath)) nothing is built, and the host is only shipped if it already exists.
       Pass -p:SkipModsHost=true to leave the host alone altogether. -->
  <PropertyGroup>
    <ModsHostDir>$(MSBuildThisFileDirectory)..\..\mods\host\</ModsHostDir>
    <BunExe Condition="'$(BunPath)' != ''">$(BunPath)</BunExe>
    <BunExe Condition="'$(BunExe)' == ''">bun</BunExe>
  </PropertyGroup>

  <ItemGroup>
    <ModsHostSource Include="$(ModsHostDir)src\**\*.ts" />
  </ItemGroup>

  <Target Name="BuildModsHost" BeforeTargets="AssignTargetPaths" Condition="'$(SkipModsHost)' != 'true' And '$(DesignTimeBuild)' != 'true'"
          Inputs="$(ModsHostDir)package.json;$(ModsHostDir)bun.lock;@(ModsHostSource)" Outputs="$(ModsHostDir)dist\host.js">
    <Exec Command="&quot;$(BunExe)&quot; --version" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" StandardErrorImportance="low" ContinueOnError="true">
      <Output TaskParameter="ExitCode" PropertyName="BunProbeExitCode" />
    </Exec>
    <Exec Condition="'$(BunProbeExitCode)' == '0'" Command="&quot;$(BunExe)&quot; install --frozen-lockfile" WorkingDirectory="$(ModsHostDir)" StandardOutputImportance="low" />
    <Exec Condition="'$(BunProbeExitCode)' == '0'" Command="&quot;$(BunExe)&quot; run build" WorkingDirectory="$(ModsHostDir)" StandardOutputImportance="low" />
  </Target>

  <Target Name="IncludeModsHost" AfterTargets="BuildModsHost" BeforeTargets="AssignTargetPaths" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup Condition="Exists('$(ModsHostDir)dist\host.js')">
      <None Include="$(ModsHostDir)dist\host.js" Link="mods-host\host.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="RequireModsHostForPublish" BeforeTargets="PrepareForPublish" Condition="'$(Configuration)' == 'Release' And '$(SkipModsHost)' != 'true'">
    <Error Condition="!Exists('$(ModsHostDir)dist\host.js')"
           Text="mods/host/dist/host.js is missing: run `bun install --frozen-lockfile &amp;&amp; bun run build` in mods/host, or pass -p:SkipModsHost=true." />
  </Target>

</Project>
